        "type": "object",
        "required": [
          "sensor",
          "timestamp"
        ],
        "title": "AggregateReading",
        "description": "A period aggregate (min/avg/max) weather measurement."
      },
      "AlertCreate": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "sensor": {
            "type": "string",
            "title": "Sensor"
          },
          "field": {
            "type": "string",
            "enum": [
              "temperature",
              "humidity",
              "pressure",
              "rain",
              "snow"
            ],
            "title": "Field"
          },
          "condition": {
            "$ref": "#/components/schemas/Condition"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "fr"
            ],
            "title": "Language",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
