    "/api/sensors": {
      "get": {
        "summary": "Get Sensors",
        "operationId": "get_sensors_api_sensors_get",
        "parameters": [
          {
            "name": "names",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only sensors with these exact names",
              "title": "Names"
            },
            "description": "Only sensors with these exact names"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only names containing this, any case",
              "title": "Q"
            },
            "description": "Only names containing this, any case"
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Map area as west,south,east,north in degrees; west > east crosses the antimeridian",
              "title": "Bbox"
            },
            "description": "Map area as west,south,east,north in degrees; west > east crosses the antimeridian"
          },
          {
            "name": "latitude",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 90,
                  "minimum": -90
                },
                {
                  "type": "null"
                }
              ],
              "description": "Sort nearest first from this point",
              "title": "Latitude"
            },
            "description": "Sort nearest first from this point"
          },
          {
            "name": "longitude",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 180,
                  "minimum": -180
                },
                {
                  "type": "null"
                }
              ],
              "description": "Sort nearest first from this point",
              "title": "Longitude"
            },
            "description": "Sort nearest first from this point"
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only sensors within this many km of the point",
              "title": "Radius"
            },
            "description": "Only sensors within this many km of the point"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 200,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "At most this many sensors; see truncated",
              "title": "Limit"
            },
            "description": "At most this many sensors; see truncated"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SensorList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
