# Auto detect text files and perform LF normalization.
*          text=auto

*.py       diff=python

# Shell scripts run in Linux containers; CRLF breaks the shebang.
*.sh       text eol=lf

# Generated files: collapse diffs in PRs.
uv.lock                   linguist-generated=true
package-lock.json         linguist-generated=true
backend/openapi.json      linguist-generated=true
frontend/src/api-types.ts linguist-generated=true
mobile/src/api-types.ts   linguist-generated=true
