location / {
    set $upstream http://tarameteo-frontend;
    proxy_pass       $upstream;
    proxy_set_header Host      $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_redirect off;
}

location /api/ {
    set $upstream http://tarameteo-api;
    proxy_pass       $upstream;
    proxy_set_header Host      $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_redirect off;
    proxy_read_timeout 3600s;
}
