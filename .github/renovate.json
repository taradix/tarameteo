{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "git-submodules": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "recreateWhen": "always",
  "npmrc": "allow-remote=all",
  "npmrcMerge": true,
  "packageRules": [
    {
      "matchPackageNames": ["typescript", "typescript-eslint"],
      "groupName": "typescript"
    },
    {
      "description": "Expo SDK pins these; upgrade with `npx expo install expo@<next> --fix`.",
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "react",
        "react-dom",
        "react-native",
        "react-native-*",
        "@shopify/react-native-skia",
        "@types/react",
        "jest",
        "jest-expo",
        "@types/jest",
        "eslint",
        "eslint-config-expo",
        "typescript"
      ],
      "enabled": false
    },
    {
      "description": "victory-native 43 needs the renamed react-native-skia; stay on 42 until the Expo SDK ships it.",
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": ["victory-native"],
      "allowedVersions": "<43"
    }
  ]
}
