{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "git-submodules": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "recreateWhen": "always",
  "npmrc": "allow-remote=all",
  "npmrcMerge": true,
  "packageRules": [
    {
      "matchPackageNames": ["typescript", "typescript-eslint"],
      "groupName": "typescript"
    },
    {
      "description": "TS majors wait for typescript-eslint peer support; tick the box on the Dependency Dashboard to try.",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
