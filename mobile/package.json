{
  "name": "tarameteo-mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "coverage": "jest --coverage",
    "openapi": "openapi-typescript ../backend/openapi.json -o src/api-types.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "setupFiles": [
      "react-native-gesture-handler/jestSetup"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/api-types.ts",
      "!src/**/*.test.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 90,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.60.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "i18next": "^27.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "victory-native": "42.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  }
}
