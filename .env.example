# Required. Primary cert CN. Must match a live/<SERVER_HOSTNAME>/ directory
# under /etc/letsencrypt once the cert has been issued.
SERVER_HOSTNAME=meteo.taram.ca

# Optional. Comma-separated extra host names nginx answers for. The cert for
# SERVER_HOSTNAME must cover them.
#ADDITIONAL_SERVER_NAMES=

# Optional. CIDR of a trusted proxy that sends the PROXY protocol; nginx then
# takes the client IP from it instead of X-Forwarded-For.
#TRUSTED_NETWORK=

# Recommended. Space-separated compose service names to SIGHUP after each
# successful renewal.
RELOAD_SERVICES=nginx

# Optional. Set to 1 to generate /etc/letsencrypt/dhparams.pem (2048-bit) on
# first renewal. nginx doesn't use it: its ciphers are all ECDHE.
#GENERATE_DHPARAMS=0

# CA token. Set CA_TOKEN to a long random hex string in your local .env
# (never commit it). If unset, the CA accepts requests without authentication.
#CA_TOKEN=

# Mosquitto configuration. Set MQTT_PASSWORD to a long random alphanumeric
# string in your local .env (never commit it).
MQTTS_PORT=8883
#MQTT_USERNAME=admin
#MQTT_PASSWORD=

# InfluxDB configuration. Set INFLUX_TOKEN and INFLUX_PASSWORD to long random
# alphanumeric strings in your local .env (never commit them).
#INFLUX_USERNAME=admin
#INFLUX_ORG=tarameteo
INFLUX_BUCKET=weather
INFLUX_RETENTION=0
#INFLUX_TOKEN=
#INFLUX_PASSWORD=

# Optional. Python version for the backend images; defaults to the one pinned
# in compose.yml.
#PYTHON_VERSION=

# COMPOSE_PROJECT_NAME is set automatically by docker compose (defaults to the
# project directory name). Override it here only if you need a non-default
# name — docker-reload.py uses it to locate sibling containers.
#COMPOSE_PROJECT_NAME=tarameteo

# Internal IPv4 /24 subnet, format n.n.n (expands to n.n.n.0/24).
# Use a private range: https://en.wikipedia.org/wiki/Private_network#Private_IPv4_addresses
IPV4_NETWORK=172.22.1

# Weather alerts. Set ALERT_SECRET to a long random hex string (never commit).
# SMTP credentials for sending alert emails (connects to your mail server).
# Either SMTP (email alerts) or FCM (app alerts) is enough; both can be set.
#ALERT_SECRET=
#SMTP_HOST=mail.taram.ca
#SMTP_PORT=587
#SMTP_USERNAME=noreply@taram.ca
#SMTP_PASSWORD=
#SMTP_FROM=noreply@taram.ca
ALERT_BASE_URL=https://meteo.taram.ca

# Push alerts to the Android app: a Firebase service-account key with the
# "Firebase Cloud Messaging API Admin" role, as base64 (never commit).
#   base64 -w0 service-account.json
#FCM_CREDENTIALS=
