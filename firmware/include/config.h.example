#ifndef CONFIG_H
#define CONFIG_H

// MQTT Server Configuration (defaults: provisioning over BLE can change them)
#define MQTT_SERVER         "meteo.taram.ca"
#define MQTT_PORT           8883

// BME280 I2C Configuration
#define BME280_ADDRESS      0x77    // I2C address: 0x76 or 0x77
#define BME280_SDA          SDA     // The board's I2C pins: D4/D5 on the XIAO C3 and S3
#define BME280_SCL          SCL
#define SEA_LEVEL_PRESSURE  1013.25f  // hPa (standard sea level pressure)

// Power Management
#define READING_INTERVAL    3600     // Seconds between readings sent to the backend (1 hour; 60 to 86400, provisionable)
#define BOOT_DELAY_MS       5000     // Cold-boot window for serial upload (skipped on deep-sleep wakeup)

// Time Management (NTP)
#define NTP_TIMEOUT_MS      10000  // 10 seconds timeout for NTP sync

// Advanced Settings
#define WIFI_TIMEOUT_MS     30000  // 30 seconds

#endif // CONFIG_H
